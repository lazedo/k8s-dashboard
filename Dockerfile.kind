# Self-contained multi-stage build of the PRE-SPLIT dashboard (with the plugin
# system) for kind. Replicates aio/scripts/build.sh but single-locale (en) to keep
# it fast. Produces the same scratch image layout the upstream aio/Dockerfile uses:
#   /dashboard  +  /public/en/...  +  /locale_conf.json
#
#   docker build -f Dockerfile.kind -t k8s-dashboard-plugins:dev .
#   kind load docker-image k8s-dashboard-plugins:dev --name <cluster>

# ---- frontend (Angular 13, Node 16) ----
FROM node:16-bullseye AS frontend
WORKDIR /src
COPY package.json package-lock.json ./
# --ignore-scripts: the postinstall is `make ensure-version && ngcc`, which needs
# make + git (absent here / .git excluded). We generate version.ts statically below
# and `ng build` runs ngcc itself.
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY . .
# version.ts is normally generated by aio/scripts/version.mjs via git-describe, but
# .git is excluded from the build context — write a static one matching VersionInfo.
RUN printf "%s\n" \
  "import {VersionInfo} from '@api/root.ui';" \
  "export const version: VersionInfo = {dirty:false,raw:'v2.7.0-plugins',hash:'pre-split',distance:0,tag:'v2.7.0',semver:{raw:'2.7.0',major:2,minor:7,patch:0,prerelease:[],build:[],version:'2.7.0',loose:false,options:{includePrerelease:false,loose:false}},suffix:'',semverString:'2.7.0',packageVersion:'2.7.0'};" \
  > src/app/frontend/environments/version.ts \
 && npx ng build --configuration production --localize=false --output-path=/frontend/en
# locale config the backend's localehandler reads (en-only).
RUN printf '{"version":"v2.7.0","defaultLocale":"en","supportedLocales":["en"],"translations":["en"]}' > /frontend/locale_conf.json

# ---- backend (Go 1.19) ----
FROM golang:1.19-bullseye AS backend
WORKDIR /go/src/github.com/kubernetes/dashboard
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
      -ldflags "-X github.com/kubernetes/dashboard/src/app/backend/client.Version=v2.7.0-plugins" \
      -o /dashboard ./src/app/backend

# ---- assemble (scratch, like upstream aio/Dockerfile) ----
FROM scratch AS final
COPY --from=backend /etc/passwd /etc/passwd
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /dashboard /dashboard
COPY --from=frontend /frontend/en /public/en
COPY --from=frontend /frontend/locale_conf.json /locale_conf.json
EXPOSE 9090 8443
ENTRYPOINT ["/dashboard", "--insecure-bind-address=0.0.0.0", "--bind-address=0.0.0.0"]
